{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@zgeoff/oxlint-config/oxlintrc.json"],
  "env": {
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [".claude/**", ".reviews/**", ".worktrees/**"],
  // the browser lane runs `*.browser.test.ts` against a real browser, 10 s per test
  "rules": {
    "zgeoff/max-test-timeout": ["error", { "lanes": { "browser": 10000 } }],
    "zgeoff/test-beside-module": ["error", { "lanes": { "browser": 10000 } }]
  }
}
