{
  "name": "@wringer/stream",
  "version": "0.0.0",
  "description": "The stream driver for wringer: records a target's logs during a run and reads them from a cursor",
  "homepage": "https://github.com/zgeoff/wringer/tree/main/packages/stream#readme",
  "bugs": "https://github.com/zgeoff/wringer/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/wringer.git",
    "directory": "packages/stream"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsrs -p tsconfig.build.json",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "xstate": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@wringer/core": "workspace:*"
  },
  "peerDependencies": {
    "@wringer/core": "workspace:*"
  },
  "engines": {
    "bun": ">=1.3"
  }
}
