{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  // co-located test files and test helpers never ship; declaration emit skips them
  "exclude": ["src/**/*.test.ts", "src/test-utils"]
}
