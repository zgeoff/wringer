{
  "name": "@wringer/core",
  "version": "0.2.0",
  "description": "The core of wringer: the envelope, the registry, the fence, the run state and the evidence",
  "homepage": "https://github.com/zgeoff/wringer/tree/main/packages/core#readme",
  "bugs": "https://github.com/zgeoff/wringer/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/wringer.git",
    "directory": "packages/core"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "dist",
    "envelope.schema.json",
    "!src/test-utils"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./envelope.schema.json": "./envelope.schema.json",
    "./test-utils/*": "./src/test-utils/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsrs -p tsconfig.build.json",
    "typecheck": "tsrs --noEmit",
    "schema": "bun scripts/write-envelope-schema.ts"
  },
  "dependencies": {
    "@zgeoff/std": "catalog:",
    "ts-pattern": "catalog:",
    "xstate": "catalog:"
  },
  "devDependencies": {
    "@zgeoff/testing": "catalog:",
    "ajv": "catalog:",
    "fast-check": "catalog:",
    "tiny-invariant": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "engines": {
    "bun": ">=1.3"
  }
}
