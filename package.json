{
  "name": "wringer",
  "private": true,
  "description": "A verification framework that each repo wraps in its own CLI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/wringer.git"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@modelcontextprotocol/client": "2.4.0",
      "@modelcontextprotocol/server": "2.4.0",
      "@mswjs/interceptors": "0.45.10",
      "@orpc/client": "1.16.1",
      "@orpc/contract": "1.16.1",
      "@orpc/openapi": "1.16.1",
      "@orpc/openapi-client": "1.16.1",
      "@orpc/server": "1.16.1",
      "@zgeoff/std": "0.4.4",
      "@zgeoff/testing": "0.3.0",
      "ajv": "8.20.0",
      "fast-check": "4.10.2",
      "gunshi": "0.37.3",
      "msw": "3.0.3",
      "playwright-core": "1.65.0",
      "tiny-invariant": "1.3.3",
      "ts-pattern": "5.9.2",
      "xstate": "5.33.3",
      "zod": "4.6.7"
    }
  },
  "type": "module",
  "scripts": {
    "audit": "bun audit --ignore=GHSA-g3hv-75wg-m249",
    "check": "bun run audit && bun run deadcode && bun run format:check && bun run lint:full && bun run typecheck && bun run prose && bun run test && bun run test:browser && bun run test:docker",
    "deadcode": "bash scripts/run-knip.sh",
    "format": "oxfmt . && { [ -z \"$(git ls-files -co --exclude-standard -- '*.ts' '*.tsx' $(sed -e '/^#/d' -e '/^$/d' -e 's/^/:(exclude,glob)/' .formatignore))\" ] || format-codemod --quiet .; }",
    "format:check": "oxfmt --check . && { [ -z \"$(git ls-files -co --exclude-standard -- '*.ts' '*.tsx' $(sed -e '/^#/d' -e '/^$/d' -e 's/^/:(exclude,glob)/' .formatignore))\" ] || format-codemod --check --quiet .; }",
    "lint": "oxlint",
    "lint:full": "TSRS_FAST=1 oxlint --type-aware --report-unused-disable-directives-severity error",
    "prepare": "command -v git > /dev/null 2>&1 && lefthook install --force || true",
    "prose": "bash .agents/skills/docs-writing/scripts/check-length.sh && bash .agents/skills/docs-writing/scripts/check-prose.sh AGENTS.md",
    "test": "bun scripts/remove-stale-test-folders.ts && bun test --randomize --pass-with-no-tests --path-ignore-patterns='**/*.browser.test.ts' --path-ignore-patterns='**/*.docker.test.ts'",
    "test:browser": "bun run --filter @wringer/browser browser:install && bun scripts/remove-stale-test-folders.ts && bun test --randomize --timeout 10000 .browser.test.ts",
    "test:docker": "bun packages/db/src/test-utils/create-test-images.ts && bun test --timeout 15000 .docker.test.ts",
    "typecheck": "tsrs --fast --noEmit && bun run --filter '*' typecheck",
    "verify": "bun packages/shop-example/src/verify-wringer.ts",
    "verify:shop": "bun packages/shop-example/src/verify-shop.ts",
    "test:related": "bun scripts/run-related-tests.ts",
    "check:commits": "chex commits",
    "check:local-paths": "chex local-paths",
    "check:test-timeouts": "chex test-timeouts",
    "check:dependency-gates": "chex dependency-gates",
    "check:workflows": "chex workflows",
    "check:uncommitted": "chex uncommitted",
    "check:docs": "chex prose length links readmes skill",
    "ci:dispatch-publish": "bun scripts/publish/dispatch-release-publish.ts",
    "ci:publish-packages": "bun scripts/publish/publish-packages.ts",
    "ci:verify-pr": "bun scripts/verify-pr/check-verify-pr.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.3",
    "@wringer/core": "workspace:*",
    "@zgeoff/agent-hooks": "0.2.14",
    "@zgeoff/bun-test-extended": "0.2.4",
    "@zgeoff/chex": "0.3.6",
    "@zgeoff/commitlint-config": "0.1.0",
    "@zgeoff/diet": "0.2.3",
    "@zgeoff/format-codemod": "0.3.5",
    "@zgeoff/oxlint-config": "0.10.10",
    "@zgeoff/testing": "catalog:",
    "knip": "6.44.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "ts-pattern": "5.9.2",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.3"
}
