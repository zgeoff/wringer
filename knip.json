{
  "$schema": "./node_modules/knip/schema.json",
  // repo-sync delivers .claude/ verbatim
  "ignore": [".claude/**"],
  // the shared oxlint config loads the plugin, and the synced skill-gate hook in .claude/ imports
  // the package, so knip sees neither
  "ignoreDependencies": ["@stylistic/eslint-plugin", "@zgeoff/skill-gate"],
  // repo-sync delivers these scripts from zgeoff/tools and overwrites a local edit, and they export
  // types that only their own file uses
  // the test script names its roots, so knip reads no package's tests from it
  "workspaces": {
    // the journey test launches the example app as a process, so no module imports it
    ".": {
      "entry": [
        "scripts/**/*.test.ts",
        "test-utils/**/*.test.ts",
        "integration/**/*.test.ts",
        "integration/shop-app.ts"
      ]
    },
    "packages/*": { "entry": ["src/**/*.test.ts"] },
    // the verify CLI tests start this script as a process, so no module imports it
    "packages/gunshi": {
      "entry": ["src/**/*.test.ts", "test-utils/**/*.test.ts", "test-utils/demo-cli.ts"]
    }
  },
  "ignoreIssues": {
    "scripts/parse-shell-words.ts": ["types"],
    "scripts/shell-escape-parsers.ts": ["types"]
  }
}
